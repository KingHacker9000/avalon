avalon.ashishajin.com {
  encode zstd gzip

  # Avalon runs on the Raspberry Pi. The Pi port is private to the tailnet;
  # Lightsail remains the only public HTTP/HTTPS edge.
  reverse_proxy 100.113.112.87:4173

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
