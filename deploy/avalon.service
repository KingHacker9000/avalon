[Unit]
Description=Avalon multiplayer web app
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=ashish
Group=ashish
WorkingDirectory=/srv/avalon/current
Environment=NODE_ENV=production
Environment=AVALON_DATA_DIR=/var/lib/avalon
ExecStart=/usr/bin/npm exec -- vinext start -H 100.113.112.87 -p 4173
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/avalon

[Install]
WantedBy=multi-user.target
