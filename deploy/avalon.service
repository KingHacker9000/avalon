[Unit]
Description=Avalon multiplayer web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/avalon/current
Environment=NODE_ENV=production
Environment=AVALON_DATA_DIR=/var/lib/avalon
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/avalon

[Install]
WantedBy=multi-user.target
